spring.data.mongodb.uri=${MONGODB_URI:mongodb://localhost:27017}
spring.data.mongodb.database=thindesk
spring.data.mongodb.auto-index-creation=true
spring.mongodb.embedded.data=file:src/main/resources/chamados.json

spring.security.user.name=${THINDESK_ADMIN_USERNAME:admin}
spring.security.user.password=${THINDESK_ADMIN_PASSWORD}

spring.thymeleaf.prefix=classpath:/templates
spring.thymeleaf.suffix=.html
spring.thymeleaf.mode=HTML
spring.thymeleaf.cache=false

thindesk.dashboard.prazo-horas=48
thindesk.seed.enabled=${THINDESK_SEED:false}
